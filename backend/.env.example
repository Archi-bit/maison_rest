# Copy to backend/.env and replace both placeholders before starting.
DB_NAME=maison
DB_USER=maison
DB_PASSWORD=replace-with-your-local-password
DB_HOST=localhost
DB_PORT=5432
SECRET_KEY=replace-with-a-generated-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Use 0.0.0.0:80 on the server to accept external HTTP requests.
HTTP_BIND=127.0.0.1:80
# Enable these for a TLS deployment behind Nginx.
HTTPS_ENABLED=False
HTTPS_BIND=127.0.0.1:443
CSRF_TRUSTED_ORIGINS=
# Comma-separated frontend origins allowed to access the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
